  "taskMappings": [
    {
      "taskType": "feature",
      "primaryCapability": "code",
      "secondaryCapabilities": ["logic", "design"]
    },
    {
      "taskType": "bugfix",
      "primaryCapability": "code",
      "secondaryCapabilities": ["logic"]
    },
    {
      "taskType": "refactor",
      "primaryCapability": "refactor",
      "secondaryCapabilities": ["code"]
    },
    {
      "taskType": "design",
      "primaryCapability": "design",
      "secondaryCapabilities": ["logic"]
    },
    {
      "taskType": "ui",
      "primaryCapability": "ui",
      "secondaryCapabilities": ["image"]
    },
    {
      "taskType": "test",
      "primaryCapability": "test",
      "secondaryCapabilities": ["code"]
    },
    {
      "taskType": "docs",
      "primaryCapability": "docs",
      "secondaryCapabilities": ["logic"]
    },
    {
      "taskType": "review",
      "primaryCapability": "review",
      "secondaryCapabilities": ["code", "logic"]
    },
    {
      "taskType": "analysis",
      "primaryCapability": "logic",
      "secondaryCapabilities": ["design"]
    },
    {
      "taskType": "planning",
      "primaryCapability": "logic",
      "secondaryCapabilities": ["design"]
    }
  ],
  "selectionConfig": {
    "strategy": "highest_score",
    "maxRetries": 3,
    "fallbackEnabled": true,
    "costThreshold": 50,
    "reliabilityThreshold": 70
  },
  "costOptimization": {
    "enabled": true,
    "monthlyBudget": 100,
    "currentSpend": 0,
    "preferCheaper": true,
    "cheaperFor": ["test", "docs", "refactor"]
  },
  "fallbackRules": [
    {
      "condition": "cost > threshold",
      "action": "use_cheaper_alternative"
    },
    {
      "condition": "reliability < threshold",
      "action": "use_more_reliable"
    },
    {
      "condition": "rate_limit_exceeded",
      "action": "use_alternative_provider"
    }
  ]
}
